{
  "name": "apimcp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "API MCP 服务 (Windows) — 本地接口设计与调试，内置 MCP 服务与可视化控制台",
  "bin": {
    "apimcp": "./src/main.js"
  },
  "scripts": {
    "start": "node src/main.js",
    "serve": "node src/main.js --serve",
    "stdio": "node src/main.js --stdio",
    "assets": "node scripts/gen-assets.mjs",
    "icon": "node scripts/gen-icon.mjs",
    "test": "node --test --test-timeout=25000 \"test/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dev:desktop": "node scripts/build-desktop.mjs --bundle-only && electron dist/desktop/app"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.2.3",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6"
  },
  "engines": {
    "node": ">=20"
  }
}
